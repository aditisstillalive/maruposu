{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "git": {
    "deploymentEnabled": {
      "**": false,
      "main": true
    }
  },
  "ignoreCommand": "[ \"$VERCEL_ENV\" = \"production\" ] && exit 1 || exit 0",
  "crons": [
    {
      "path": "/api/cron/replica-sync",
      "schedule": "0 20 * * *"
    }
  ]
}
