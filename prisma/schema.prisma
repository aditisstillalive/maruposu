generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// One row per café branch. Only one outlet exists for now ("default"), but every
// outlet-scoped table carries outlet_id so a second branch can be added later.
model Outlet {
  id         String   @id @default(cuid())
  name       String
  address    String?
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  setting       Setting?
  employees     Employee[]
  categories    Category[]
  option_groups OptionGroup[]
  promos        Promo[]
  ingredients   Ingredient[]
  shifts        Shift[]
  orders        Order[]
}

// Per-outlet configuration. The master PIN unlocks the POS on a device; bumping
// pin_version invalidates every device session issued for the old PIN.
model Setting {
  id              String   @id @default(cuid())
  outlet_id       String   @unique
  cafe_name       String
  master_pin_hash String
  pin_version     Int      @default(1)
  tax_name        String   @default("PB1")
  tax_rate_bp     Int      @default(1000) // basis points: 1000 = 10%
  tax_inclusive   Boolean  @default(true)
  receipt_footer  String?
  updated_by      String?
  updated_at      DateTime @updatedAt

  outlet Outlet @relation(fields: [outlet_id], references: [id], onDelete: Cascade)
}

// Failed master-PIN attempts, keyed per client IP. Kept in the DB (not memory)
// because serverless instances don't share in-memory counters.
model PinThrottle {
  key          String    @id
  failures     Int       @default(0)
  locked_until DateTime?
  updated_at   DateTime  @updatedAt
}

model AdminUser {
  id         String   @id @default(cuid())
  email      String   @unique
  password   String? // bcrypt hash
  role       String   @default("admin") // "super_admin" | "admin"
  added_by   String?
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
}

// Staff who serve customers. Picked from a card grid on the POS (no personal PIN).
model Employee {
  id         String   @id @default(cuid())
  outlet_id  String
  name       String
  photo_url  String?
  is_active  Boolean  @default(true)
  sort_order Int      @default(0)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  outlet Outlet @relation(fields: [outlet_id], references: [id], onDelete: Cascade)

  @@index([outlet_id, is_active])
}

model Category {
  id         String   @id @default(cuid())
  outlet_id  String
  name       String
  sort_order Int      @default(0)
  is_active  Boolean  @default(true)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  outlet   Outlet    @relation(fields: [outlet_id], references: [id], onDelete: Cascade)
  products Product[]

  @@unique([outlet_id, name])
}

model Product {
  id          String   @id @default(cuid())
  category_id String
  name        String
  description String?
  price       Int // IDR, tax handling per Setting.tax_inclusive
  photo_url   String?
  is_active   Boolean  @default(true)
  is_sold_out Boolean  @default(false)
  sort_order  Int      @default(0)
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  category      Category             @relation(fields: [category_id], references: [id], onDelete: Restrict)
  option_groups ProductOptionGroup[]
  recipe        RecipeLine[]

  @@index([category_id])
}

// A reusable set of choices: a variant group (pick exactly one, e.g. Hot/Ice, sugar
// level) or an add-on group (pick zero or more, each with its own price).
model OptionGroup {
  id         String   @id @default(cuid())
  outlet_id  String
  name       String
  kind       String // "variant" | "addon"
  required   Boolean  @default(false)
  min_select Int      @default(0)
  max_select Int      @default(1)
  sort_order Int      @default(0)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  outlet   Outlet               @relation(fields: [outlet_id], references: [id], onDelete: Cascade)
  options  Option[]
  products ProductOptionGroup[]
}

model Option {
  id          String  @id @default(cuid())
  group_id    String
  name        String
  price_delta Int     @default(0) // IDR added to the product price
  is_default  Boolean @default(false)
  is_active   Boolean @default(true)
  sort_order  Int     @default(0)

  group  OptionGroup  @relation(fields: [group_id], references: [id], onDelete: Cascade)
  recipe RecipeLine[]
}

model ProductOptionGroup {
  id         String @id @default(cuid())
  product_id String
  group_id   String
  sort_order Int    @default(0)

  product Product     @relation(fields: [product_id], references: [id], onDelete: Cascade)
  group   OptionGroup @relation(fields: [group_id], references: [id], onDelete: Cascade)

  @@unique([product_id, group_id])
}

// Replica sync bookkeeping, stored on the primary only (one row, id "replica").
// `dirty` means the replica missed a change and needs a full sync before it can
// serve reads; `changed_at` is the last change it missed.
model SyncState {
  id             String    @id
  dirty          Boolean   @default(true)
  changed_at     DateTime?
  last_synced_at DateTime?
  last_error     String?
  updated_at     DateTime  @updatedAt
}

// Who did what to sensitive data (PIN changes, prices, tax, later voids and cash).
model AuditLog {
  id         String   @id @default(cuid())
  actor      String // admin email or "employee:<id>"
  action     String // e.g. "master_pin.change", "product.update"
  target     String?
  detail     Json?
  created_at DateTime @default(now())

  @@index([created_at])
  @@index([action])
}

// ---------------------------------------------------------------------------
// POS transactions (F2). Shift, CashMovement, Order, OrderItem, Refund and
// RefundItem ids are UUIDs made on the tablet, so a row created offline keeps
// its id when it reaches the server. Employee ids are plain strings: employees
// are deactivated, never deleted.
// ---------------------------------------------------------------------------

model Promo {
  id           String    @id @default(cuid())
  outlet_id    String
  name         String
  code         String? // coupon code, uppercase; null = picked from the list
  kind         String // "percent" | "amount"
  value        Int // basis points for percent, rupiah for amount
  max_discount Int?
  scope        String // "bill" | "product" | "category"
  product_ids  String[]
  category_ids String[]
  min_spend    Int       @default(0)
  starts_at    DateTime?
  ends_at      DateTime?
  days         Int[] // WIB weekdays, 0 = Sunday; empty = every day
  time_start   String? // "HH:mm" WIB
  time_end     String?
  quota        Int?
  used_count   Int       @default(0)
  is_active    Boolean   @default(true)
  created_at   DateTime  @default(now())
  updated_at   DateTime  @updatedAt

  outlet Outlet @relation(fields: [outlet_id], references: [id], onDelete: Cascade)

  @@unique([outlet_id, code])
}

model Shift {
  id            String   @id
  outlet_id     String
  device_id     String
  business_date String // YYYY-MM-DD, WIB day ending 04:00
  opening_float Int
  opened_by     String
  opened_at     DateTime
  status        String   @default("open") // "open" | "closed"

  // Closing (F3). Counted by denomination; expected/variance are the server's.
  closed_at       DateTime?
  closed_by       String? // employee id, or admin email when closed_via = "admin"
  closed_via      String? // "tablet" | "admin"
  denominations   Json? // { notes: { "100000": 2, ... }, coins: 1500 }
  counted_cash    Int?
  expected_cash   Int?
  client_expected Int? // what the tablet showed, when it differed
  variance        Int? // counted - expected
  close_note      String?
  sync_note       String?
  summary         Json? // ShiftSummary at closing

  outlet         Outlet         @relation(fields: [outlet_id], references: [id], onDelete: Cascade)
  orders         Order[]
  cash_movements CashMovement[]
  refunds        Refund[]

  @@index([outlet_id, status])
}

model CashMovement {
  id          String   @id
  shift_id    String
  kind        String // "paid_in" | "paid_out" | "refund_out"
  amount      Int
  note        String
  employee_id String
  refund_id   String?  @unique
  created_at  DateTime

  shift  Shift   @relation(fields: [shift_id], references: [id], onDelete: Cascade)
  refund Refund? @relation(fields: [refund_id], references: [id], onDelete: Cascade)
}

model Order {
  id             String    @id
  outlet_id      String
  shift_id       String
  code           String    @unique
  number         Int // daily sequence shown big on the barista ticket
  business_date  String
  status         String    @default("open") // "open" | "paid" | "void" | "refunded"
  order_type     String // "dine_in" | "takeaway"
  customer_name  String?
  table_no       String?
  created_by     String
  paid_by        String?
  subtotal       Int       @default(0)
  discount       Int       @default(0)
  tax            Int       @default(0)
  total          Int       @default(0)
  promo_id       String?
  promo_name     String?
  payment_method String? // "cash" | "edc" | "qris"
  cash_received  Int?
  change         Int?
  payment_ref    String?
  paid_at        DateTime?
  void_reason    String?
  voided_by      String?
  voided_at      DateTime?
  sync_note      String? // set when the server's math disagreed with the tablet's
  created_at     DateTime
  updated_at     DateTime  @updatedAt

  outlet  Outlet      @relation(fields: [outlet_id], references: [id], onDelete: Cascade)
  shift   Shift       @relation(fields: [shift_id], references: [id], onDelete: Cascade)
  items   OrderItem[]
  refunds Refund[]

  @@index([shift_id, status])
  @@index([business_date])
}

model OrderItem {
  id              String  @id
  order_id        String
  product_id      String?
  category_id     String?
  name            String
  base_price      Int
  unit_price      Int // base + options
  qty             Int
  note            String?
  discount        Int     @default(0) // this line's share of the promo
  paid            Int     @default(0) // this line's share of the total
  refunded_qty    Int     @default(0)
  refunded_amount Int     @default(0)
  sort_order      Int     @default(0)
  cogs            Int     @default(0) // cost of the ingredients used, at payment (F4)

  order        Order             @relation(fields: [order_id], references: [id], onDelete: Cascade)
  options      OrderItemOption[]
  refund_items RefundItem[]
}

model OrderItemOption {
  id            String  @id @default(cuid())
  order_item_id String
  option_id     String?
  group_name    String
  name          String
  price_delta   Int

  item OrderItem @relation(fields: [order_item_id], references: [id], onDelete: Cascade)
}

model Refund {
  id          String   @id
  order_id    String
  shift_id    String
  method      String // "cash" (from the drawer) | "cashless"
  amount      Int
  tax         Int
  reason      String
  employee_id String
  created_at  DateTime

  order         Order         @relation(fields: [order_id], references: [id], onDelete: Cascade)
  shift         Shift         @relation(fields: [shift_id], references: [id], onDelete: Cascade)
  items         RefundItem[]
  cash_movement CashMovement?
}

model RefundItem {
  id            String @id
  refund_id     String
  order_item_id String
  qty           Int
  amount        Int

  refund Refund    @relation(fields: [refund_id], references: [id], onDelete: Cascade)
  item   OrderItem @relation(fields: [order_item_id], references: [id], onDelete: Cascade)
}

// Every mutation a tablet has sent, so a resend is recognised (primary only).
model PosMutation {
  id         String   @id
  device_id  String
  type       String
  status     String // "applied" | "rejected"
  error      String?
  created_at DateTime @default(now())
}

// ---------------------------------------------------------------------------
// Inventory (F4). Quantities are whole numbers in the ingredient's unit;
// avg_cost_milli is milli-rupiah per unit (weighted average of stock-ins).
// ---------------------------------------------------------------------------

model Ingredient {
  id             String   @id @default(cuid())
  outlet_id      String
  name           String
  unit           String // "g" | "ml" | "pcs"
  purchase_unit  String? // e.g. "karton"
  purchase_size  Int? // units per purchase unit, e.g. 12000 (ml)
  stock          Int      @default(0)
  avg_cost_milli Int      @default(0)
  min_stock      Int?
  is_active      Boolean  @default(true)
  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt

  outlet    Outlet          @relation(fields: [outlet_id], references: [id], onDelete: Cascade)
  recipe    RecipeLine[]
  movements StockMovement[]

  @@unique([outlet_id, name])
}

// One ingredient of a product's base recipe or of an option's extra.
model RecipeLine {
  id            String  @id @default(cuid())
  ingredient_id String
  product_id    String?
  option_id     String?
  qty           Int

  ingredient Ingredient @relation(fields: [ingredient_id], references: [id], onDelete: Cascade)
  product    Product?   @relation(fields: [product_id], references: [id], onDelete: Cascade)
  option     Option?    @relation(fields: [option_id], references: [id], onDelete: Cascade)

  @@unique([product_id, option_id, ingredient_id])
}

// Every change to an ingredient's stock, with the balance after it.
model StockMovement {
  id              String   @id @default(cuid())
  outlet_id       String
  ingredient_id   String
  kind            String // "sale" | "purchase" | "opname" | "waste"
  qty             Int // signed
  unit_cost_milli Int
  balance         Int
  ref_type        String // "order" | "purchase" | "opname" | "waste"
  ref_id          String
  note            String?
  actor           String
  created_at      DateTime @default(now())

  ingredient Ingredient @relation(fields: [ingredient_id], references: [id], onDelete: Cascade)

  @@index([ingredient_id, created_at])
  @@index([ref_type, ref_id])
}

model Purchase {
  id         String   @id @default(cuid())
  outlet_id  String
  supplier   String?
  note       String?
  total      Int
  created_by String
  created_at DateTime @default(now())

  items PurchaseItem[]
}

model PurchaseItem {
  id            String @id @default(cuid())
  purchase_id   String
  ingredient_id String
  qty           Int
  total_cost    Int

  purchase Purchase @relation(fields: [purchase_id], references: [id], onDelete: Cascade)
}

model StockOpname {
  id         String   @id @default(cuid())
  outlet_id  String
  note       String?
  created_by String
  created_at DateTime @default(now())

  lines StockOpnameLine[]
}

model StockOpnameLine {
  id            String @id @default(cuid())
  opname_id     String
  ingredient_id String
  system_qty    Int
  counted_qty   Int
  diff          Int

  opname StockOpname @relation(fields: [opname_id], references: [id], onDelete: Cascade)
}

model Waste {
  id         String   @id // uuid from the tablet, cuid from the admin
  outlet_id  String
  source     String // "tablet" | "admin"
  reason     String // "rusak" | "kadaluarsa" | "salah_buat" | "tumpah" | "lainnya"
  note       String?
  actor      String
  cost       Int      @default(0)
  created_at DateTime

  lines WasteLine[]
}

model WasteLine {
  id            String  @id @default(cuid())
  waste_id      String
  ingredient_id String?
  product_id    String?
  name          String
  qty           Int

  waste Waste @relation(fields: [waste_id], references: [id], onDelete: Cascade)
}
