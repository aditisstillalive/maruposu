# Postgres (Neon in production; `npm run db:local` prints a local URL)
DATABASE_URL=
# Optional second database: shares staleness-tolerant POS reads, kept in sync from the primary
DATABASE_URL_REPLICA=
# Authorizes the daily Vercel crons (/api/cron/replica-sync, /api/cron/vouchers)
CRON_SECRET=

# next-auth (admin back-office)
NEXTAUTH_URL=http://localhost:3200
NEXTAUTH_SECRET=

# Signs the POS device session cookie issued after the master PIN
DEVICE_SESSION_SECRET=

# Cloudflare R2 (product and employee photos)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=

# Printed vouchers from tokoiboek (the source of truth). Same token on both apps, at least 24 characters.
# Locally TOKOIBOEK_URL must point at a mock, never at production.
TOKOIBOEK_URL=https://tokoiboek.vercel.app
VOUCHER_SYNC_TOKEN=

# Only read by `npm run db:seed`
SEED_SUPER_ADMIN_EMAIL=aditisstillalive@gmail.com
SEED_SUPER_ADMIN_PASSWORD=
SEED_MASTER_PIN=
